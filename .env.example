# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# These are safe to expose in the browser bundle — RLS policies are what actually
# protect the data. Never put the Supabase service_role key or the Anthropic API
# key in a VITE_ variable; those belong server-side only (Supabase Edge Functions).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app URL for auth emails & Stripe redirects (required for iOS/Android builds).
# Web dev can omit this — localhost is used automatically.
VITE_APP_URL=https://ironmedic.vercel.app

# --- Server-side only (set these as Supabase Edge Function secrets, NOT here) ---
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_PRICE_BASIC=price_...     # Basic $14 CAD/mo
# supabase secrets set STRIPE_PRICE_PRO=price_...        # Pro $24 CAD/mo
# supabase secrets set STRIPE_PRICE_PREMIUM=price_...    # Premium $39 CAD/mo
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set TRIAL_DAYS=7
# supabase secrets set BASIC_MONTHLY_MESSAGE_LIMIT=75
# supabase secrets set ANTHROPIC_MODEL_STANDARD=claude-haiku-4-5
# supabase secrets set ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-5
# supabase secrets set RESEND_API_KEY=re_...
# supabase secrets set RESEND_FROM="IronMedic <onboarding@resend.dev>"
# supabase secrets set APP_URL=https://ironmedic.vercel.app
